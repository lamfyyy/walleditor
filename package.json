    "expo-image-manipulator": "~57.0.0",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@kawarp/core": "^1.1.1",
    "@types/react": "~19.2.0",
    "esbuild": "^0.25.0",
